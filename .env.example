# GenQuiz Environment Variables Configuration
# Copy this file to .env and insert your API credentials if using live LLM generation.
# If no key is set, the application seamlessly runs in DEMO MODE using verified dataset records.

# Primary Recommended Provider: Groq (Ultra-fast inference, free tier available at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary Alternative Provider: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Default Provider Selection ("groq", "openai", or "demo")
LLM_PROVIDER=groq
